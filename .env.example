# Copy to .env and fill in the blanks:   cp .env.example .env
# .env is git-ignored. Never commit real keys or passwords.

# ---------------------------------------------------------------- Aviationstack
AVIATIONSTACK_KEY=

# ---------------------------------------------------------------- Kafka
KAFKA_BOOTSTRAP=kafka:9094
KAFKA_TOPIC=flight_live
HOST_KAFKA_PORT=9094

# ---------------------------------------------------------------- Spark
CHECKPOINT_DIR=/tmp/chk/flights_stream

# ---------------------------------------------------------------- Postgres warehouse
# The same values configure the Postgres container and every client (Spark, loader, sheets sink, Airflow tasks).
PGHOST=flight_postgres
PGPORT=5432
PGDATABASE=flight_pipeline
PGUSER=flight_user
PGPASSWORD=change-me

# ---------------------------------------------------------------- Google Sheets
GSHEET_ID=
GSHEET_TAB=flight_curated
GSHEET_BATCH_SIZE=300
GSHEET_INTERVAL_SEC=30
# Host path of the service-account JSON key (mounted read-only into the containers).
GSA_KEY_PATH=~/gsa/gsa-keys.json

# ---------------------------------------------------------------- Airflow
# Metadata database (created on first start of the Postgres volume by db/02_create_airflow_db.sh).
AIRFLOW_DB_PASSWORD=change-me-too
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-three
